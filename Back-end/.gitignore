# Backend .gitignore

# Environment variables & Security Secrets
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
!.env.example
!.env.template

# Security keys & certificates
*.pem
*.key
*.cert
*.crt
secrets.json

# Node Modules & Package Locks
node_modules/

# Database files & Local dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
data/
dumps/

# Uploads & Temporary files
uploads/
temp/
tmp/
public/uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
